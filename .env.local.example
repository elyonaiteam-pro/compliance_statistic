TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token

# Gmail SMTP — used to send login codes and change-notification emails.
# No custom domain needed: enable 2FA on this Gmail account, then create an
# "App Password" at https://myaccount.google.com/apppasswords
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# DonatePay (payments)
DONATEPAY_API_KEY=
DONATEPAY_PAGE_URL=https://donatepay.ru/d/your-page
